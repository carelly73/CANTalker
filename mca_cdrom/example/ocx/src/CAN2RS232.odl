			//    Use extreme caution when editing this section.
			//{{AFX_ODL_METHOD(CCAN2RS232Ctrl)
			[id(1)] boolean Initialize(short port, long brate);
			[id(2)] void Close();
			[id(3)] boolean SetCanID(boolean extMode, long canID);
			[id(4)] boolean SetRs232BaudRate(long brate);
			[id(5)] void SetCanBaudRate(short brate);
			[id(6)] void ReqCanStatus();
			[id(7)] boolean SendMessage(long canID, short len, short data0, short data1, short data2, short data3, short data4, short data5, short data6, short data7);
			[id(8)] void SetBitTiming(short BRGCON1, short BRGCON2, short BRGCON3);
			[id(9)] void SetAcceptacneFilter(long mask1, long mask2, long filter1, long filter2, long filter3, long filter4, long filter5, long filter6);
			//}}AFX_ODL_METHOD

			[id(DISPID_ABOUTBOX)] void AboutBox();
