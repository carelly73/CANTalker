#include <olectl.h>
#include <idispids.h>

[ uuid(0C7CE946-FCCB-4370-BD70-CC0F25319297), version(1.0),
  helpfile("CAN2RS232.hlp"),
  helpstring("CAN2RS232 ActiveX Control module"),
  control ]
library CAN2RS232Lib
{
	importlib(STDOLE_TLB);
	importlib(STDTYPE_TLB);

	//  Primary dispatch interface for CCAN2RS232Ctrl

	[ uuid(B32F5754-04FA-4D54-9E5D-F19A69D9A880),
	  helpstring("Dispatch interface for CAN2RS232 Control"), hidden ]
	dispinterface _DCAN2RS232
	{
		properties:
			// NOTE - ClassWizard will maintain property information here.
			//    Use extreme caution when editing this section.
			//{{AFX_ODL_PROP(CCAN2RS232Ctrl)
