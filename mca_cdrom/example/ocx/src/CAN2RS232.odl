	//  Event dispatch interface for CCAN2RS232Ctrl

	[ uuid(1D3A5B8A-6C8A-4887-B84B-FF1EBF82D29E),
	  helpstring("Event interface for CAN2RS232 Control") ]
	dispinterface _DCAN2RS232Events
	{
		properties:
			//  Event interface has no properties

		methods:
			// NOTE - ClassWizard will maintain event information here.
			//    Use extreme caution when editing this section.
			//{{AFX_ODL_EVENT(CCAN2RS232Ctrl)
			[id(1)] void PacketReceived(long canID, short length, short data0, short data1, short data2, short data3, short data4, short data5, short data6, short data7);
			[id(2)] void ProtocolAcknowlegde(boolean isError, short ErrCode);
			[id(3)] void RspCanStauts(short status, long canID, short BRGCON1, short BRGCON2, short BRGCON3);
			//}}AFX_ODL_EVENT
